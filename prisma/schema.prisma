generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  loginId      String         @unique
  passwordHash String
  name         String
  role         String // "COACH" | "PLAYER"
  createdAt    DateTime       @default(now())
  profile      PlayerProfile?
  records      DailyRecord[]
}

model PlayerProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthDate    DateTime
  sex          String   @default("MALE") // "MALE" | "FEMALE"
  position     String // "GK" | "DF" | "MF" | "FW"
  grade        Int // 1..3 (高1..高3)
  jerseyNumber Int?
  photoData    String? // data URL(アップロード時にクライアント側で縮小済み)
}

model DailyRecord {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         String // "YYYY-MM-DD"
  weightKg     Float?
  heightCm     Float?
  sleepHours   Float?
  sleepQuality Int? // 1..5
  condition    Int? // 1..5 主観コンディション
  fatigue      Int? // 1..5 疲労度(5=強い)
  soreness     Int? // 1..5 筋肉痛・違和感(5=強い)
  rpe          Int? // 1..10 トレーニング強度
  mealsJson    String? // {"breakfast":{"ate":true,"tags":["主食",...]},...}
  note         String?
  workouts     WorkoutEntry[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, date])
  @@index([date])
}

model WorkoutEntry {
  id        String      @id @default(cuid())
  recordId  String
  record    DailyRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  userId    String // 非正規化。ランキング/推移クエリを join なしで引くため
  date      String // "YYYY-MM-DD" (DailyRecord.date と同じ形式)
  exercise  String // src/lib/workout.ts の EXERCISES の key
  order     Int // 画面上の並び順
  weightKg  Float? // WEIGHT種目の重量 / BODYWEIGHT種目の加重。TIME種目は null
  reps      Int? // WEIGHT / BODYWEIGHT種目の回数
  seconds   Int? // TIME種目(プランク等)の秒数
  sets      Int
  rpe       Int? // 1..10 その種目のきつさ
  createdAt DateTime    @default(now())

  @@index([userId, date])
  @@index([userId, exercise, date])
  @@index([recordId])
}
