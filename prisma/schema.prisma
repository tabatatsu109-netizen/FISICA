generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Team {
  id        String   @id @default(cuid())
  code      String   @unique // ログイン時に入力する短い英数字 例: "seiryo"
  name      String // 表示名 例: "青陵高校サッカー部"
  createdAt DateTime @default(now())
  users     User[]
}

model User {
  id             String         @id @default(cuid())
  // "チームコード-個人ID" の連結文字列(ADMIN はプレフィックスなし)。
  // 複合ユニークにしないのは、ADMIN の teamId が null になり
  // Postgres が NULL を互いに異なる値として扱うため重複を防げないから。
  loginId        String         @unique
  passwordHash   String
  name           String
  role           String // "ADMIN" | "COACH" | "PLAYER"
  // 増やすと、そのユーザーの発行済みCookieがすべて無効になる。
  // パスワード再発行時に増やして、古い端末を締め出す。
  sessionVersion Int            @default(0)
  teamId         String? // ADMIN(運営者)のみ null
  team           Team?          @relation(fields: [teamId], references: [id])
  createdAt      DateTime       @default(now())
  profile        PlayerProfile?
  records        DailyRecord[]

  @@index([teamId])
}

/// ログインの連続失敗を記録して総当たりを止める。
/// 存在しないログインIDも記録する。記録の有無で実在するIDが分かってしまうため。
model LoginAttempt {
  loginId     String    @id
  failures    Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?

  @@index([windowStart])
}

model PlayerProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthDate    DateTime
  sex          String   @default("MALE") // "MALE" | "FEMALE"
  position     String // "GK" | "DF" | "MF" | "FW"
  grade        Int // 1..3 (高1..高3)
  jerseyNumber Int?
  photoData    String? // data URL(アップロード時にクライアント側で縮小済み)
}

model DailyRecord {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         String // "YYYY-MM-DD"
  weightKg     Float?
  heightCm     Float?
  sleepHours   Float?
  sleepQuality Int? // 1..5
  condition    Int? // 1..5 主観コンディション
  fatigue      Int? // 1..5 疲労度(5=強い)
  soreness     Int? // 1..5 筋肉痛・違和感(5=強い)
  rpe          Int? // 1..10 トレーニング強度
  mealsJson    String? // {"breakfast":{"ate":true,"tags":["主食",...]},...}
  note         String?
  workouts     WorkoutEntry[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([userId, date])
  @@index([date])
}

model WorkoutEntry {
  id        String      @id @default(cuid())
  recordId  String
  record    DailyRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  userId    String // 非正規化。ランキング/推移クエリを join なしで引くため
  date      String // "YYYY-MM-DD" (DailyRecord.date と同じ形式)
  exercise  String // src/lib/workout.ts の EXERCISES の key
  order     Int // 画面上の並び順
  weightKg  Float? // WEIGHT種目の重量 / BODYWEIGHT種目の加重。TIME種目は null
  reps      Int? // WEIGHT / BODYWEIGHT種目の回数
  seconds   Int? // TIME種目(プランク等)の秒数
  sets      Int
  rpe       Int? // 1..10 その種目のきつさ
  createdAt DateTime    @default(now())

  @@index([userId, date])
  @@index([userId, exercise, date])
  @@index([recordId])
}
