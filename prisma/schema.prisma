generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  loginId      String         @unique
  passwordHash String
  name         String
  role         String // "COACH" | "PLAYER"
  createdAt    DateTime       @default(now())
  profile      PlayerProfile?
  records      DailyRecord[]
}

model PlayerProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthDate    DateTime
  sex          String   @default("MALE") // "MALE" | "FEMALE"
  position     String // "GK" | "DF" | "MF" | "FW"
  grade        Int // 1..3 (高1..高3)
  jerseyNumber Int?
  photoData    String? // data URL(アップロード時にクライアント側で縮小済み)
}

model DailyRecord {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         String // "YYYY-MM-DD"
  weightKg     Float?
  heightCm     Float?
  sleepHours   Float?
  sleepQuality Int? // 1..5
  condition    Int? // 1..5 主観コンディション
  fatigue      Int? // 1..5 疲労度(5=強い)
  soreness     Int? // 1..5 筋肉痛・違和感(5=強い)
  rpe          Int? // 1..10 トレーニング強度
  mealsJson    String? // {"breakfast":{"ate":true,"tags":["主食",...]},...}
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, date])
  @@index([date])
}
